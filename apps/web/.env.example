# WalletConnect Cloud project id (optional — injected wallets work without it)
NEXT_PUBLIC_WC_PROJECT_ID=
# Deployed AgentTill — leave unset for demo/mock mode
NEXT_PUBLIC_AGENT_TILL_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_DEFAULT_NETWORK=testnet

# ─── Marketing pages (/lp/judges, /lp/developers) ────────────────────────────
# Arc mainnet AgentTill address. Unset → mainnet row shows "Deploying — testnet live".
NEXT_PUBLIC_AGENT_TILL_ADDRESS_MAINNET=
# Set to true only after the mainnet source is verified on explorer.arc.io (shows "Verified on Arc").
NEXT_PUBLIC_AGENT_TILL_MAINNET_VERIFIED=false
# DoraHacks / GitHub profile of the builder (Arc Microgrants criterion).
NEXT_PUBLIC_BUILDER_PROFILE_URL=
# 16:9 demo video (mp4/webm). A sibling .vtt with the same basename is used for captions.
NEXT_PUBLIC_DEMO_VIDEO_URL=
